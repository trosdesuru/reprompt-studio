# Caddyfile
develop.reprompt.studio {
    # Compresión para mejorar el Core Web Vitals
    encode zstd gzip

    # 🛡️ Seguridad extra: Cabeceras de protección
    header {
        # Permite que las cookies funcionen bien en OAuth
        Access-Control-Allow-Credentials true
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    # Redirigir el tráfico de la API al Backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # El resto al Frontend
    handle {
        reverse_proxy frontend:3000
    }
}