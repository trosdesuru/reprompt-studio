{
  "name": "frontend-galeria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node diagnose.js && next dev",
    "build": "next build",
    "format": "prettier --write \"{app,src}/**/*.{ts,tsx,css}\"",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:seed": "cd .. && docker compose exec -T backend python scripts/e2e_seed.py",
    "db:clean": "cd .. && docker compose exec -T backend python scripts/e2e_clean.py",
    "test:e2e": "npm run db:seed && npx playwright test ; npm run db:clean"
  },
