    "@tabler/icons-react": "^3.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
