          );
        })}
      </div>

      {hasMorePages && (
        <div ref={ref} className="w-full flex justify-center py-8">
          {isLoadingMore ? (
            <div className="w-8 h-8 rounded-full border-4 border-(--accent-color) border-t-transparent animate-spin" />
