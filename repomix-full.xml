<file path="frontend/src/store/searchStore.ts">
import { useProgressStore } from "./progressStore";
import { create } from "zustand";
import { api } from "@/src/services/api";
import { GalleryItem } from "@/src/types/gallery";
import { handleError } from "../utils/errors/ErrorHandler";

interface SearchState {
  query: string;
  results: GalleryItem[];
  isLoading: boolean;
  isLoadingMore: boolean;
  error: string | null;
  nextCursor: string | null;
  hasMore: boolean;
  activeCategories: Record<string, boolean>;
  
  setQuery: (q: string) => void;
  toggleCategory: (id: string) => void;
  executeSearch: () => Promise<void>;
  loadMore: () => Promise<void>;
  trending: GalleryItem[];
  fetchTrending: () => Promise<void>;
}

export const useSearchStore = create<SearchState>((set, get) => ({
  query: "",
  results: [],
  trending: [],
  isLoading: false,
  isLoadingMore: false,
  error: null,
  nextCursor: null,
  hasMore: false,
  activeCategories: {
    misc: false, doujinshi: true, manga: false, artistcg: false, gamecg: false,
    western: false, nonh: false, imageset: false, cosplay: false, asianporn: false,
  },

  setQuery: (q) => set({ query: q }),
  
  toggleCategory: (id) =>
    set((state) => ({
      activeCategories: { ...state.activeCategories, [id]: !state.activeCategories[id] },
    })),

  executeSearch: async () => {
    useProgressStore.getState().start();
    const { query, activeCategories } = get();
    if (!query) return;
    
    set({ isLoading: true, error: null, results: [], nextCursor: null, hasMore: true });

    try {
      const data = await api.buscar(query, null, activeCategories);
      if (process.env.NODE_ENV === "development") console.log("🚨 TELEMETRÍA [API INITIAL SEARCH]:", data);

      if (data.status === "success") {
        set({
          results: data.data || [],
          nextCursor: data.next_id || null,
          hasMore: !!data.next_id,
        });
      }
    } catch (err: unknown) {
      const cleanMessage = handleError(err, "SearchStore");
      set({ error: cleanMessage });
    } finally {
      set({ isLoading: false });
      useProgressStore.getState().done();
    }
  },

  // ✅ AQUÍ ESTÁ EL CÓDIGO REAL RESTAURADO
  loadMore: async () => {
    useProgressStore.getState().start();
    const { query, nextCursor, hasMore, isLoadingMore, activeCategories, results } = get();
    
    if (process.env.NODE_ENV === "development") console.log("🚨 TELEMETRÍA [STORE]: Ejecutando loadMore. Estado actual:", { isLoadingMore, hasMore, nextCursor });

    // Bloqueamos si ya está cargando o no hay más páginas
    if (isLoadingMore || !hasMore || !nextCursor) {
      if (process.env.NODE_ENV === "development") console.warn("🚨 TELEMETRÍA [STORE]: Petición bloqueada (ya cargando o sin cursor).");
      return;
    }
    
    set({ isLoadingMore: true });

    try {
      console.log(`🚨 TELEMETRÍA [STORE]: Pidiendo página con cursor: ${nextCursor}`);
      const data = await api.buscar(query, nextCursor, activeCategories);
      
      if (process.env.NODE_ENV === "development") console.log("🚨 TELEMETRÍA [API LOAD MORE]:", data);

      if (data.status === "success" && data.data && data.data.length > 0) {
        const combined = [...results, ...data.data];
        
        // Filtramos duplicados usando la URL como ID único
        const unique = Array.from(new Map(combined.map((item) => [item.url, item])).values());

        // 🛡️ CIRCUIT BREAKER
        if (unique.length === results.length) {
          if (process.env.NODE_ENV === "development") console.warn("🚨 CIRCUIT BREAKER: El Backend mandó los mismos resultados. Cortando el bucle.");
          set({ hasMore: false });
        } else {
          set({
            results: unique,
            nextCursor: data.next_id || null,
            hasMore: !!data.next_id, // Si no hay next_id, desactivamos el Infinite Scroll
          });
        }
      } else {
        if (process.env.NODE_ENV === "development") console.warn("🚨 TELEMETRÍA [STORE]: La API devolvió un array vacío. Fin de los resultados.");
        set({ hasMore: false });
      }
    } catch (err) {
      if (process.env.NODE_ENV === "development") console.error("🚨 TELEMETRÍA [STORE]: Error al cargar más:", err);
    } finally {
      set({ isLoadingMore: false });
      useProgressStore.getState().done();
    }
  },

  // ✅ CÓDIGO RESTAURADO PARA LAS TENDENCIAS DE LA HOME
  fetchTrending: async () => {
    useProgressStore.getState().start();
    try {
      const data = await api.obtenerTendencias(5);
      if (data.status === "success") set({ trending: data.data });
      useProgressStore.getState().done();
    } catch (err) {
      console.error("Error cargando tendencias:", err);
      useProgressStore.getState().done();
    }
  },
}));
</file>

<file path="frontend/src/system/molecules/SearchCategorySelector.tsx">
"use client";
import * as React from "react";
import { EH_CATEGORIES } from "@/src/constants/filters";
import { IconChevronDown } from "@tabler/icons-react";
import {
  Combobox,
  ComboboxChips,
  ComboboxChipsInput,
  ComboboxContent,
  ComboboxEmpty,
  ComboboxItem,
  ComboboxList,
  ComboboxValue,
  useComboboxAnchor,
} from "@/components/ui/combobox";

interface Props {
  activeCategories: Record<string, boolean>;
  onToggle: (id: string) => void;
}

export function SearchCategorySelector({ activeCategories, onToggle }: Props) {
  const anchor = useComboboxAnchor();

  const selectedLabels = React.useMemo(
    () => EH_CATEGORIES.filter((c) => activeCategories[c.id]).map((c) => c.label),
    [activeCategories],
  );

  return (
    <Combobox
      multiple
      items={EH_CATEGORIES.map((c) => c.label)}
      value={selectedLabels}
      onValueChange={(labels) => {
        EH_CATEGORIES.forEach((c) => {
          const isActive = !!activeCategories[c.id];
          const shouldBeActive = labels.includes(c.label);
          if (isActive !== shouldBeActive) onToggle(c.id);
        });
      }}
    >
      {/* 🟢 FIX: Restauramos ComboboxChips original, pero con nuestros estilos */}
      <ComboboxChips
        ref={anchor}
        className="relative w-140px h-full flex items-center px-3 bg-muted/60 dark:bg-white/5 border-transparent border-r-border/50 cursor-pointer hover:bg-muted transition-colors rounded-none shadow-none"
      >
        <ComboboxValue>
          {(values) => (
            <div className="flex items-center justify-between w-full pointer-events-none z-10">
              {values.length === 0 ? (
                <span className="text-[11px] font-bold text-muted-foreground uppercase">
                  Filtros
                </span>
              ) : (
                <span className="text-[11px] font-black text-(--accent-color) uppercase tracking-tight">
                  {values.length === EH_CATEGORIES.length ? "Todo" : `${values.length} CAT`}
                </span>
              )}
              <IconChevronDown size={14} className="text-muted-foreground" />
            </div>
          )}
        </ComboboxValue>

        <ComboboxChipsInput
          className="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20"
          readOnly
        />
      </ComboboxChips>

      <ComboboxContent
        anchor={anchor}
        className="z-101 min-w-200px bg-background border border-border shadow-xl"
      >
        <ComboboxEmpty className="p-2 text-xs text-muted-foreground">
          No hay categorías.
        </ComboboxEmpty>
        <ComboboxList className="max-h-300px overflow-y-auto">
          {(item) => {
            const cat = EH_CATEGORIES.find((c) => c.label === item);
            const isActive = cat ? activeCategories[cat.id] : false;

            return (
              <ComboboxItem
                key={item}
                value={item}
                className="text-xs font-medium cursor-pointer p-2 hover:bg-muted"
              >
