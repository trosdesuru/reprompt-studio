from pydantic import BaseModel
from typing import Optional, Dict, Any
from datetime import datetime
from fastapi import Form


class PromptCreate(BaseModel):
    title: str = "Generación IA"
    prompt: str
    negative_prompt: Optional[str] = None
    software: Optional[str] = "Desconocido"
    model: Optional[str] = None
    sampler: Optional[str] = None

    steps: Optional[str] = None
    cfg_scale: Optional[str] = None
    seed: Optional[str] = None
    resolution: Optional[str] = None
    image_url: Optional[str] = None
    extra_data: Dict[str, Any] = {}


class PromptResponse(PromptCreate):
    id: int
    user_id: int
    collection_id: Optional[int] = None
    created_at: datetime

    class Config:
        from_attributes = True


def prompt_form_dependency(
    title: str = Form("Generación IA"),
    prompt: str = Form(...),
    negative_prompt: Optional[str] = Form(None),
    software: Optional[str] = Form("Desconocido"),
    model: Optional[str] = Form(None),
    sampler: Optional[str] = Form(None),
    steps: Optional[str] = Form(None),
    cfg_scale: Optional[str] = Form(None),
    seed: Optional[str] = Form(None),
    resolution: Optional[str] = Form(None),
) -> PromptCreate:
    """Extrae los campos del form-data y los valida contra el esquema"""
    return PromptCreate(
        title=title,
        prompt=prompt,
        negative_prompt=negative_prompt,
        software=software,
        model=model,
        sampler=sampler,
        steps=steps,
        cfg_scale=cfg_scale,
        seed=seed,
        resolution=resolution,
    )
</file>

<file path="backend/app/init_db.py">
import secrets
import logging
from sqlmodel import SQLModel, Session, select
from app.core.db import engine
from app.models.user import InviteCode, User, AuditLog
from app.models.gallery import GalleryMetric
from app.models.prompt import ImagePrompt
from app.models.collection import Collection
from app.models.prompt import ImagePrompt

logger = logging.getLogger("init_db")


def init_db():
    logger.info("⏳ Conectando a Neon.tech y sincronizando tablas...")
    try:
        SQLModel.metadata.create_all(engine)
        logger.info("✅ Sincronización de tablas completada.")
    except Exception as e:
        logger.error(f"❌ Error crítico sincronizando tablas: {e}")
        raise e

    with Session(engine) as session:
        existing_code = session.exec(select(InviteCode)).first()

        if not existing_code:
            master_code = f"TROYA-{secrets.token_hex(4).upper()}"
            new_invite = InviteCode(code=master_code)

            session.add(new_invite)
            session.commit()

            logger.info("✨ Base de Datos inicializada por primera vez.")
            logger.warning("=" * 40)
            logger.warning(f"🔑 TU CÓDIGO MAESTRO ES: {master_code}")
            logger.warning("⚠️ Cópialo ahora. Úsalo para crear tu cuenta Admin.")
            logger.warning("=" * 40)
        else:
            logger.info("✅ Las tablas ya existían y la base de datos está lista.")


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO)
    init_db()
</file>

