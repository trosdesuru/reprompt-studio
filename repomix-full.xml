        className,
      )}
      onClick={onClick}
    >
      <MediaCover src={data.imageUrl} alt={data.title} aspectRatio={data.aspectRatio} />

      {/* Solo mostramos el overlay si hay una imagen válida para evitar ruido visual */}
      {data.imageUrl && (
        <MediaOverlay
          title={data.title}
          prompt={data.prompt}
          tags={data.tags}
          variant={variant}
          onDownload={onDownload ? handleDownload : undefined}
        />
      )}
    </div>
  );
}
